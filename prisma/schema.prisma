generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model NavItem {
  id        String @id @default(uuid())
  sectionId String @unique
  label     String
  order     Int    @default(0)
}

model CoreArea {
  id     String  @id @default(uuid())
  title  String
  blurb  String
  order  Int     @default(0)
  points Point[]
}

model Point {
  id         String   @id @default(uuid())
  text       String
  coreAreaId String
  coreArea   CoreArea @relation(fields: [coreAreaId], references: [id], onDelete: Cascade)
}

model SkillGroup {
  id     String      @id @default(uuid())
  name   String
  accent String
  order  Int         @default(0)
  items  SkillItem[]
}

model SkillItem {
  id           String     @id @default(uuid())
  name         String
  skillGroupId String
  skillGroup   SkillGroup @relation(fields: [skillGroupId], references: [id], onDelete: Cascade)
}

model Project {
  id      String         @id @default(uuid())
  title   String
  tag     String
  summary String
  impact  String
  repoUrl String?
  order   Int            @default(0)
  stack   ProjectStack[]
}

model ProjectStack {
  id        String  @id @default(uuid())
  name      String
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model JourneyStep {
  id    String @id @default(uuid())
  year  String
  title String
  text  String
  order Int    @default(0)
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model Experience {
  id          String   @id @default(uuid())
  role        String
  company     String
  duration    String
  description String
  achievement String?
  order       Int      @default(0)
  stack       ExperienceStack[]
}

model ExperienceStack {
  id           String     @id @default(uuid())
  name         String
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
}

model Education {
  id           String      @id @default(uuid())
  degree       String
  college      String
  duration     String
  cgpa         String
  description  String
  hasDeepDive  Boolean     @default(false)
  order        Int         @default(0)
  subjects     Subject[]
  cocurricular Cocurricular[]
}

model Subject {
  id          String    @id @default(uuid())
  name        String
  educationId String
  education   Education @relation(fields: [educationId], references: [id], onDelete: Cascade)
}

model Cocurricular {
  id          String    @id @default(uuid())
  text        String
  educationId String
  education   Education @relation(fields: [educationId], references: [id], onDelete: Cascade)
}

model Certification {
  id             String           @id @default(uuid())
  name           String
  issuer         String
  date           String
  hasDeepDive    Boolean          @default(false)
  order          Int              @default(0)
  subCertificates SubCertificate[]
}

model SubCertificate {
  id              String        @id @default(uuid())
  name            String
  category        String
  instructor      String
  description     String
  duration        String
  certificateUrl  String
  certificationId String
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
}

model GlobalConfig {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model SecurityLog {
  id        String   @id @default(uuid())
  ip        String
  event     String
  details   String?
  severity  String   @default("low")
  timestamp DateTime @default(now())
}
