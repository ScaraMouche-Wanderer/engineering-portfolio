# ===================================================
# Main Portfolio Environment Configuration
# ===================================================

# SQLite. Relative paths are resolved from the project root by the app.
# For deployment and Prisma CLI commands, use an absolute persistent path.
DATABASE_URL="file:./dev.db"

# Example deployment: DATABASE_URL="file:/srv/portfolio-data/site.db"
# Turso/PostgreSQL require a separate schema/adapter migration; URLs alone do not enable them.

# Optional: Instant Contact Form Alert Webhook (Discord / Slack / Telegram / Zapier)
# CONTACT_WEBHOOK_URL="https://discord.com/api/webhooks/your/webhook/url"
